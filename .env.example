PORT=8010
NODE_ENV=development
APP_NAME=SmatSnap

# Database (MySQL)
DEV_DB_NAME=photo_sharing
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306

PROD_DB_NAME=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=
PROD_DB_HOST=
PROD_DB_PORT=3306

# JWT signing secrets (long random strings, different per environment)
DEV_SECRET=change-me
PROD_SECRET=

# Mail (SMTP). SendGrid works via SMTP: host smtp.sendgrid.net, user "apikey", password = the SendGrid API key.
# If SMTP_HOST is empty in development, OTPs are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SmatSnap <no-reply@example.com>"

# S3 (event media). Same IAM credentials as tese-backend (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY).
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=smatechgroup-photo-sharing-app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Presigned upload URL lifetimes (hours, max 168). Single-file PUT URLs / per-part URLs for large files.
UPLOAD_URL_TTL_HOURS=24
PART_URL_TTL_HOURS=6

# Face matching (AWS Rekognition isn't available in af-south-1). Uses the S3 credentials.
REKOGNITION_REGION=us-east-1
REKOGNITION_COLLECTION_PREFIX=lumina-dev
FACE_MATCH_THRESHOLD=90

# Payments: each photographer's country picks the gateway (helpers/payments/countries.js):
# ZW → SmatPay, ZA/NG/GH/KE → Paystack. A country only shows up when its gateway is configured.
# Optional override per country, e.g. PAYMENT_ROUTES=ZW:smatpay,ZA:paystack
PAYMENT_ROUTES=
# Public HTTPS base of this API (Paystack return page + webhook: <API_PUBLIC_URL>/api/payments/paystack/webhook)
API_PUBLIC_URL=

# Paystack (South Africa, Nigeria, Ghana, Kenya): photographers are subaccounts. sk_test_… or sk_live_…
PAYSTACK_SECRET_KEY=

# SmatPay (Zimbabwe; photographers are SmatPay merchants, registered at signup like tese-backend)
SMATPAY_API_URL=https://dev.smatpay.africa:8443
SMATPAY_PLANE=sandbox
# SmatPay product code for content-creator (merchant) signup. "Tese" is Tese's code and is only
# allowed on the sandbox plane until SmatPay issues ours.
SMATPAY_PRODUCT_CODE=Tese
# Encrypts stored merchant keys (AES-256-GCM): 32 random bytes, base64:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
TOKEN_ENCRYPTION_KEY=
# Platform fee added to each payment (like tese's video_payment_*_fee settings): fraction + fixed amount.
PLATFORM_FEE_PERCENT=0.05
PLATFORM_FEE_FIXED=0
# How long buyers can download purchased originals.
PURCHASE_DOWNLOAD_DAYS=30

# Admin dashboard base (photo-admin/, served under /admin) — used in admin invite emails
ADMIN_DASHBOARD_URL=
